# Copia este archivo como .env y rellena los valores:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS / Linux)

# Clave de API de OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=tu-clave-aqui

# Puerto del servidor (opcional; si no se define, se usa 3000)
# PORT=3000

# Proveedor del agente de voz en vivo (intercambiable)
# elevenlabs (activo) | openai (stub — aún no implementado)
VOICE_AGENT_PROVIDER=elevenlabs
# VOICE_AGENT_PROVIDER=openai

# ElevenLabs — TTS de nota de voz (https://elevenlabs.io)
# ELEVENLABS_VOICE_ID=VmejBeYhbrcTPwDniox7
# Requiere permiso convai_write (Conversational AI) para emitir tokens WebRTC
ELEVENLABS_API_KEY=

# ElevenLabs Agents — modo “Hablar en vivo con Martina” (WebRTC)
# Nunca exponer API key, webhook secret ni tool secret al navegador.
ELEVENLABS_AGENT_ID=agent_3901kx6z99b3efdr80dwe2j3pp0y
ELEVENLABS_ENVIRONMENT=production
ELEVENLABS_CONVAI_WEBHOOK_SECRET=
ELEVENLABS_TOOL_SECRET=
# true | false — desactiva el botón en vivo sin afectar chat ni nota de voz
ELEVENLABS_LIVE_ENABLED=true
# Solo desarrollo: permitir pageUrl en localhost
# ELEVENLABS_ALLOW_LOCAL_PAGE_HOSTS=true

# Supabase — historial de chat + prerreservas + live_conversations
# Proyecto: https://dftbelnombbtjryqphaa.supabase.co
# Usa la service role solo en el backend (nunca en el widget / frontend).
SUPABASE_URL=https://dftbelnombbtjryqphaa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Memoria operativa Markdown para el prompt de Martina (opcional; por defecto: ./config/memoria.md)
# MARTINA_MEMORIA_PATH=L:/ChatBotAmarte/config/memoria.local.md
